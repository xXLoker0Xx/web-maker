---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Política de Cookies - Web Maker';
const description = 'Política de cookies de Web Maker. Información sobre cómo utilizamos cookies en nuestro sitio.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />

  <main class="flex-grow bg-gray-50">
    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="max-w-5xl mx-auto w-full px-6 py-4 text-sm text-gray-500">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-[var(--primary)] transition-colors">Inicio</a></li>
        <li>/</li>
        <li class="text-gray-900 font-medium" aria-current="page">Política de Cookies</li>
      </ol>
    </nav>

    {/* Hero Section */}
    <div class="hero-gradient text-white rounded-[var(--radius)] shadow-lg max-w-5xl mx-auto w-full px-6 mb-12 p-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4">Política de Cookies</h1>
      <p class="text-lg opacity-90">Cómo utilizamos cookies y tecnologías similares</p>
    </div>

    <div class="max-w-5xl mx-auto px-6 pb-20">
      
      {/* Última actualización */}
      <p class="text-gray-600 text-sm mb-12">
        Última actualización: {new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      {/* Contenido */}
      <div class="space-y-8">
        <section class="bg-white rounded-[var(--radius)] border border-gray-100 p-8 shadow-sm">
          <div class="flex items-start gap-4 mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 bg-[var(--primary)] text-white font-bold rounded-full flex-shrink-0 text-sm">1</span>
            <h2 class="text-2xl font-bold text-gray-900">¿Qué son las Cookies?</h2>
          </div>
          <p class="text-gray-700 leading-relaxed ml-14">
            Las cookies son pequeños archivos de texto que se almacenan en tu dispositivo cuando visitas un sitio web. Se utilizan para recordar información sobre tu visita, como preferencias y comportamiento de navegación.
          </p>
        </section>

        <section class="bg-white rounded-[var(--radius)] border border-gray-100 p-8 shadow-sm">
          <div class="flex items-start gap-4 mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 bg-[var(--primary)] text-white font-bold rounded-full flex-shrink-0 text-sm">2</span>
            <h2 class="text-2xl font-bold text-gray-900">Tipos de Cookies que Usamos</h2>
          </div>
          <div class="ml-14 space-y-6">
            <div>
              <h3 class="font-semibold text-gray-900 mb-3">Cookies Esenciales</h3>
              <p class="text-gray-700">Necesarias para el funcionamiento básico del sitio (autenticación, seguridad).</p>
            </div>

            <div>
              <h3 class="font-semibold text-gray-900 mb-3">Cookies de Rendimiento</h3>
              <p class="text-gray-700">Ayudan a entender cómo los visitantes usan nuestro sitio (Google Analytics).</p>
            </div>

            <div>
              <h3 class="font-semibold text-gray-900 mb-3">Cookies de Funcionalidad</h3>
              <p class="text-gray-700">Recuerdan tus preferencias y opciones anteriores.</p>
            </div>

            <div>
              <h3 class="font-semibold text-gray-900 mb-3">Cookies de Marketing</h3>
              <p class="text-gray-700">Utilizadas por terceros (como Amazon) para marketing y publicidad.</p>
            </div>
          </div>
        </section>

        <section class="bg-white rounded-[var(--radius)] border border-gray-100 p-8 shadow-sm">
          <div class="flex items-start gap-4 mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 bg-[var(--primary)] text-white font-bold rounded-full flex-shrink-0 text-sm">3</span>
            <h2 class="text-2xl font-bold text-gray-900">Control de Cookies</h2>
          </div>
          <div class="ml-14">
            <p class="text-gray-700 mb-4">Puedes controlar las cookies a través de tu navegador:</p>
            <ul class="space-y-2 text-gray-700">
              <li class="flex items-center gap-2"><span class="text-[var(--primary)]">•</span> Aceptar todas las cookies</li>
              <li class="flex items-center gap-2"><span class="text-[var(--primary)]">•</span> Rechazar cookies no esenciales</li>
              <li class="flex items-center gap-2"><span class="text-[var(--primary)]">•</span> Eliminar cookies existentes</li>
              <li class="flex items-center gap-2"><span class="text-[var(--primary)]">•</span> Configurar preferencias personalizadas</li>
            </ul>
            <p class="text-gray-700 mt-4">
              <strong>Nota:</strong> Rechazar cookies puede afectar la funcionalidad de algunas características del sitio.
            </p>
          </div>
        </section>

        <section class="bg-white rounded-[var(--radius)] border border-gray-100 p-8 shadow-sm">
          <div class="flex items-start gap-4 mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 bg-[var(--primary)] text-white font-bold rounded-full flex-shrink-0 text-sm">4</span>
            <h2 class="text-2xl font-bold text-gray-900">Cookies de Terceros</h2>
          </div>
          <div class="ml-14">
            <p class="text-gray-700 mb-4">Algunos servicios que utilizamos establece sus propias cookies:</p>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-2">
                <span class="text-[var(--primary)] mt-1">•</span>
                <div>
                  <strong>Google Analytics:</strong> Para analizar el tráfico del sitio
                </div>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-[var(--primary)] mt-1">•</span>
                <div>
                  <strong>Amazon Associates:</strong> Para procesar enlaces de afiliados
                </div>
              </li>
            </ul>
          </div>
        </section>

        <section class="bg-white rounded-[var(--radius)] border border-gray-100 p-8 shadow-sm">
          <div class="flex items-start gap-4 mb-4">
            <span class="inline-flex items-center justify-center w-10 h-10 bg-[var(--primary)] text-white font-bold rounded-full flex-shrink-0 text-sm">5</span>
            <h2 class="text-2xl font-bold text-gray-900">Tus Derechos</h2>
          </div>
          <p class="text-gray-700 leading-relaxed ml-14">
            Tienes derecho a saber qué cookies usamos y a controlar tu experiencia. Si tienes preguntas sobre nuestras prácticas de cookies, <a href="mailto:contacto@example.com" class="text-[var(--primary)] hover:underline">contáctanos</a>.
          </p>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
