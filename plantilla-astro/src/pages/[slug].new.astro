---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import BestProductSection from '../components/BestProductSection.astro';
import ProductCard from '../components/ProductCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import BuyingCriteria from '../components/BuyingCriteria.astro';
import FAQ from '../components/FAQ.astro';
import DisclaimerBanner from '../components/DisclaimerBanner.astro';
import Footer from '../components/Footer.astro';
import type { NicheContent } from '../content/config';
import fs from 'fs';
import path from 'path';

interface Props {
  content: NicheContent;
  slug: string;
}

// Generar rutas estáticas leyendo directamente los archivos JSON
export async function getStaticPaths() {
  try {
    const nichesDir = path.join(process.cwd(), 'src', 'content', 'niches');

    if (!fs.existsSync(nichesDir)) {
      console.warn('Directorio niches no encontrado:', nichesDir);
      return [];
    }

    const files = fs.readdirSync(nichesDir).filter((f) => f.endsWith('.json'));

    if (!files || files.length === 0) {
      console.warn('No se encontraron archivos JSON en:', nichesDir);
      return [];
    }

    const paths = files.map((file) => {
      const slug = file.replace('.json', '');
      const filePath = path.join(nichesDir, file);
      const content = JSON.parse(fs.readFileSync(filePath, 'utf-8'));

      return {
        params: { slug },
        props: {
          content: content,
          slug: slug,
        },
      };
    });

    console.log(`Generadas ${paths.length} rutas estáticas desde JSON`);
    return paths;
  } catch (error) {
    console.error('Error en getStaticPaths:', error);
    return [];
  }
}

const { content, slug } = Astro.props;

// Generar schema para Article
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: content.title,
  description: content.description,
  datePublished: new Date().toISOString(),
  author: {
    '@type': 'Organization',
    name: 'Web Maker',
  },
};

// Generar schema para FAQ
const faqSchema = content.faq ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: content.faq.map((item: any) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : undefined;

// Criterios de compra con iconos
const buyingCriteria = [
  { icon: '⚡', title: 'Rendimiento', description: 'Velocidad y eficiencia en su función principal' },
  { icon: '💰', title: 'Precio', description: 'Mejor relación calidad-precio' },
  { icon: '🛡️', title: 'Durabilidad', description: 'Calidad de construcción y garantía' },
  { icon: '⭐', title: 'Reseñas', description: 'Opiniones de usuarios verificados' },
  { icon: '📦', title: 'Facilidad de Uso', description: 'Configuración e instalación sencilla' },
  { icon: '🎯', title: 'Funcionalidades', description: 'Características y versatilidad' },
];
---

<BaseLayout
  title={content.title}
  description={content.description}
  articleSchema={articleSchema}
  faqSchema={faqSchema}
>
  <Header />

  <main>
    {/* Hero */}
    <Hero
      title={content.title}
      subtitle={content.description}
    />

    <div class="bg-white">
      {/* Container principal */}
      <div class="container mx-auto px-6 max-w-6xl py-12">
        {/* Disclaimer */}
        <DisclaimerBanner showAffiliate={true} />

        {/* Tabla de contenidos */}
        <nav class="mb-12 p-6 bg-gray-50 rounded-lg border border-gray-200">
          <h2 class="font-bold text-lg mb-4">Contenido de esta guía:</h2>
          <ol class="list-decimal list-inside space-y-2 text-gray-700">
            <li><a href="#best-product" class="text-blue-600 hover:underline">Nuestra Recomendación</a></li>
            <li><a href="#summary" class="text-blue-600 hover:underline">Resumen Ejecutivo</a></li>
            <li><a href="#comparison" class="text-blue-600 hover:underline">Comparativa Rápida</a></li>
            <li><a href="#products" class="text-blue-600 hover:underline">Productos Individuales</a></li>
            <li><a href="#buying-guide" class="text-blue-600 hover:underline">Guía de Compra</a></li>
            <li><a href="#criteria" class="text-blue-600 hover:underline">Criterios de Evaluación</a></li>
            <li><a href="#faq" class="text-blue-600 hover:underline">Preguntas Frecuentes</a></li>
          </ol>
        </nav>

        {/* Resumen Ejecutivo */}
        <section id="summary" class="mb-16 p-8 bg-blue-50 rounded-2xl border border-blue-200">
          <h2 class="text-3xl font-bold mb-6">Resumen Ejecutivo</h2>
          <p class="text-lg text-gray-700 mb-6 leading-relaxed">
            {content.executive_summary || content.description}
          </p>
          {content.key_takeaways && (
            <div class="grid md:grid-cols-2 gap-4">
              {content.key_takeaways.slice(0, 4).map((takeaway: string) => (
                <div class="flex gap-3">
                  <span class="text-2xl flex-shrink-0">✓</span>
                  <p class="text-gray-700">{takeaway}</p>
                </div>
              ))}
            </div>
          )}
        </section>
      </div>

      {/* Best Product Section */}
      {content.products && content.products.length > 0 && (
        <div id="best-product">
          <BestProductSection
            image={content.products[0].image_url || ''}
            title={content.products[0].title}
            rating={content.products[0].rating || 0}
            reviews={content.products[0].reviews_count || 0}
            badge="Mejor Opción"
            highlights={content.products[0].highlights || content.products[0].pros.slice(0, 3)}
            pros={content.products[0].pros}
            reason={`${content.products[0].title} es nuestro favorito porque combina excelente rendimiento, durabilidad y la mejor relación calidad-precio de su categoría.`}
            price={content.products[0].price}
            ctaLink={content.products[0].affiliate_url || `https://amazon.es/dp/${content.products[0].asin}`}
            isRecommended={true}
          />
        </div>
      )}

      {/* Comparison Section */}
      {content.products && content.products.length > 0 && (
        <div id="comparison" class="bg-gray-50 py-16">
          <div class="container mx-auto px-6 md:px-0 max-w-6xl">
            <h2 class="text-4xl font-bold mb-12">Comparativa Rápida</h2>
            <ComparisonTable products={content.products} />
          </div>
        </div>
      )}

      {/* Products Grid */}
      {content.products && content.products.length > 0 && (
        <section id="products" class="py-16">
          <div class="container mx-auto px-6 md:px-0 max-w-6xl">
            <h2 class="text-4xl font-bold mb-12">Análisis Detallado de Productos</h2>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
              {content.products.map((product: any, index: number) => (
                <ProductCard
                  asin={product.asin}
                  title={product.title}
                  image_url={product.image_url}
                  price={product.price}
                  rating={product.rating}
                  reviews_count={product.reviews_count}
                  badge={`#${index + 1}`}
                  pros={product.pros}
                  cons={product.cons}
                  summary={product.summary}
                  affiliate_url={product.affiliate_url || `https://amazon.es/dp/${product.asin}`}
                  isRecommended={index === 0}
                  ranking={index + 1}
                />
              ))}
            </div>
          </div>
        </section>
      )}

      {/* Buying Guide Section */}
      <section id="buying-guide" class="py-16 bg-gray-50">
        <div class="container mx-auto px-6 md:px-0 max-w-4xl">
          <h2 class="text-4xl font-bold mb-6">Guía de Compra</h2>
          <div class="prose max-w-none">
            {content.buying_guide && (
              <div class="text-gray-700 leading-relaxed space-y-4">
                {content.buying_guide.split('\n\n').map((paragraph: string) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            )}
          </div>
        </div>
      </section>

      {/* Buying Criteria */}
      {buyingCriteria && (
        <div id="criteria">
          <BuyingCriteria criteria={buyingCriteria} />
        </div>
      )}

      {/* FAQ Section */}
      {content.faq && content.faq.length > 0 && (
        <div id="faq">
          <FAQ items={content.faq} />
        </div>
      )}

      {/* Verdict Section */}
      <section class="py-16">
        <div class="container mx-auto px-6 md:px-0 max-w-4xl">
          <div class="bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 p-12 rounded-2xl">
            <h2 class="text-4xl font-bold text-green-900 mb-6">Veredicto Final</h2>
            <div class="text-lg text-green-800 leading-relaxed space-y-4">
              {content.verdict && (
                <p>{content.verdict}</p>
              )}
              <p class="font-bold text-xl pt-4">
                ✓ Nuestra recomendación es elegir el {content.products?.[0]?.title || 'producto recomendado'} por su excelente combinación de precio, rendimiento y durabilidad.
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* CTA Final */}
      <section class="py-16 bg-gradient-to-r from-blue-600 to-indigo-600 text-white">
        <div class="container mx-auto px-6 max-w-4xl text-center">
          <h2 class="text-4xl font-bold mb-6">¿Listo para Decidir?</h2>
          <p class="text-xl mb-8 text-blue-100">
            Revisaste todas las opciones. Ahora es el momento de hacer tu compra.
          </p>
          {content.products && content.products[0] && (
            <a
              href={content.products[0].affiliate_url || `https://amazon.es/dp/${content.products[0].asin}`}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="inline-block bg-white text-blue-600 px-8 py-4 rounded-lg font-bold hover:shadow-lg hover:scale-105 transition-all duration-300"
            >
              Ver en Amazon: {content.products[0].title}
            </a>
          )}
        </div>
      </section>
    </div>
  </main>

  <Footer />
</BaseLayout>
