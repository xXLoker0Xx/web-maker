---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import type { NicheContent } from '../content/config';

// Cargar todos los JSONs en src/content/
const files = import.meta.glob<{ default: NicheContent }>('../content/**/*.json', {
  eager: true,
  import: 'default',
});

const nichesArray = Object.entries(files)
  .map(([path, module]) => {
    const filename = path.split('/').pop() || '';
    const slug = filename.replace('.json', '');
    return {
      slug,
      title: module.title,
      description: module.description,
      count: module.products ? module.products.length : 0,
    };
  })
  .sort(() => Math.random() - 0.5); // Opcional: aleatorio

const totalNiches = nichesArray.length;
const totalProducts = nichesArray.reduce((sum, n) => sum + n.count, 0);

const title = 'Comparativas de Productos - Web Maker';
const description = 'Guías de compra y comparativas de productos de calidad. Análisis independientes para ayudarte a elegir lo mejor.';
---

<BaseLayout title={title} description={description}>
  <Header title="Web Maker" />

  <main>
    {/* Hero Section */}
    <Hero
      title="Encuentra los Mejores Productos"
      subtitle="Comparativas independientes y análisis detallados para tomar las mejores decisiones de compra"
      cta={{
        text: 'Explorar Categorías',
        href: '#niches',
      }}
    />

    {/* Stats Section */}
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div class="p-8">
            <div class="text-5xl font-bold text-blue-600 mb-2">{totalNiches}</div>
            <p class="text-gray-600 text-lg">Categorías Analizadas</p>
          </div>
          <div class="p-8">
            <div class="text-5xl font-bold text-blue-600 mb-2">{totalProducts}</div>
            <p class="text-gray-600 text-lg">Productos Comparados</p>
          </div>
          <div class="p-8">
            <div class="text-5xl font-bold text-blue-600 mb-2">100%</div>
            <p class="text-gray-600 text-lg">Análisis Independiente</p>
          </div>
        </div>
      </div>
    </section>

    {/* Por qué confiar en nosotros */}
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-6 max-w-4xl">
        <h2 class="text-4xl font-bold text-center mb-12">¿Por qué Confiar en Nosotros?</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="text-4xl mb-4">🔍</div>
            <h3 class="text-xl font-bold mb-2">Análisis Detallado</h3>
            <p class="text-gray-600">Investigamos cada producto a fondo para ofrecerte información completa y honesta.</p>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-4">⭐</div>
            <h3 class="text-xl font-bold mb-2">Opiniones Reales</h3>
            <p class="text-gray-600">Basamos nuestras recomendaciones en miles de reseñas y datos verificados.</p>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-4">✓</div>
            <h3 class="text-xl font-bold mb-2">Sin Sesgos</h3>
            <p class="text-gray-600">Nuestras evaluaciones son independientes y nunca están influenciadas por intereses comerciales.</p>
          </div>
        </div>
      </div>
    </section>

    {/* Niches Grid */}
    <section id="niches" class="py-20 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <h2 class="text-4xl font-bold text-center mb-4">Explora Nuestras Comparativas</h2>
        <p class="text-center text-gray-600 text-lg mb-12 max-w-2xl mx-auto">
          Selecciona una categoría para ver análisis detallados, comparativas y recomendaciones de los mejores productos.
        </p>

        {nichesArray.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {nichesArray.map((niche) => (
              <a
                href={`/${niche.slug}/`}
                class="group relative p-8 bg-gradient-to-br from-blue-50 to-indigo-50 rounded-2xl border border-blue-200 hover:border-blue-400 hover:shadow-lg transition-all duration-300"
              >
                <div class="absolute top-4 right-4 text-3xl opacity-20 group-hover:opacity-100 transition-opacity">
                  →
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-2 pr-8">{niche.title}</h3>
                <p class="text-gray-700 mb-4">{niche.description}</p>
                <div class="flex items-center gap-2 text-blue-600 font-semibold">
                  <span class="bg-blue-100 text-blue-900 px-3 py-1 rounded-lg text-sm">📦 {niche.count} productos</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-20">
            <p class="text-2xl font-bold text-gray-900 mb-4">📋 Sin comparativas aún</p>
            <p class="text-gray-600">Ejecuta <code class="bg-gray-100 px-2 py-1 rounded">python main.py</code> para generar tu primera página</p>
          </div>
        )}
      </div>
    </section>

    {/* CTA Final */}
    <section class="py-16 bg-gradient-to-r from-blue-600 to-indigo-600 text-white">
      <div class="container mx-auto px-6 max-w-4xl text-center">
        <h2 class="text-4xl font-bold mb-6">¿Necesitas Ayuda para Elegir?</h2>
        <p class="text-xl mb-8 text-blue-100">
          Nuestras guías de compra están diseñadas para simplificar tu decisión. Explora nuestras comparativas hoy.
        </p>
        <a
          href="#niches"
          class="inline-block bg-white text-blue-600 px-8 py-4 rounded-lg font-bold hover:shadow-lg hover:scale-105 transition-all duration-300"
        >
          Ver Todas las Comparativas
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
