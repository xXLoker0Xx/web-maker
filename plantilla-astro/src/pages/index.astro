---
import type { NicheContent } from '../content/config';

// Cargar todos los JSONs en src/content/
const files = import.meta.glob<{ default: NicheContent }>('../content/**/*.json', { 
  eager: true,
  import: 'default'
});

const nichesArray = Object.entries(files).map(([path, module]) => {
  const filename = path.split('/').pop() || '';
  const slug = filename.replace('.json', '');
  return {
    slug,
    title: module.title,
    description: module.description,
    count: module.products ? module.products.length : 0
  };
});

const totalNiches = nichesArray.length;
const totalProducts = nichesArray.reduce((sum, n) => sum + n.count, 0);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Web Maker - Páginas de Nicho para Afiliados</title>
  <meta name="description" content="Guías de compra de nichos específicos de Amazon. Análisis detallados y comparativas de productos recomendados.">
  <link rel="canonical" href={canonicalURL}>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh; padding: 20px; }
    .container { max-width: 1200px; margin: 0 auto; }
    header { text-align: center; color: white; padding: 60px 20px 40px; }
    header h1 { font-size: 2.5rem; margin-bottom: 15px; }
    header p { font-size: 1.1rem; opacity: 0.95; }
    .stats { display: flex; justify-content: center; gap: 40px; margin: 40px 0; flex-wrap: wrap; }
    .stat { background: rgba(255, 255, 255, 0.1); padding: 20px 30px; border-radius: 8px; color: white; }
    .stat-number { font-size: 2rem; font-weight: 700; }
    .content { background: white; padding: 40px; border-radius: 12px; margin: 40px 0; }
    .content h2 { color: #667eea; margin-bottom: 20px; font-size: 1.8rem; }
    .niches-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; margin: 30px 0; }
    .niche-card { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); padding: 25px; border-radius: 10px; color: white; text-decoration: none; transition: transform 0.3s; }
    .niche-card:hover { transform: translateY(-8px); }
    .niche-card h3 { font-size: 1.2rem; margin-bottom: 10px; }
    .niche-card p { font-size: 0.9rem; opacity: 0.9; margin-bottom: 15px; }
    .niche-card .meta { font-size: 0.85rem; padding-top: 15px; border-top: 1px solid rgba(255, 255, 255, 0.2); }
    .empty { text-align: center; padding: 60px 20px; color: #666; }
    footer { background: rgba(0, 0, 0, 0.8); color: white; padding: 40px 20px; margin-top: 60px; text-align: center; font-size: 0.9rem; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <h1>🎯 Web Maker</h1>
      <p>Guías de compra de nichos para afiliados de Amazon</p>
    </header>
    
    <div class="stats">
      <div class="stat">
        <div class="stat-number">{totalNiches}</div>
        <div>Nichos</div>
      </div>
      <div class="stat">
        <div class="stat-number">{totalProducts}</div>
        <div>Productos</div>
      </div>
    </div>
    
    <div class="content">
      <h2>Explora Nuestros Nichos</h2>
      {nichesArray.length > 0 ? (
        <div class="niches-grid">
          {nichesArray.map((niche) => (
            <a href={'/' + niche.slug + '/'} class="niche-card">
              <h3>{niche.title}</h3>
              <p>{niche.description}</p>
              <div class="meta">📦 {niche.count} productos</div>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty">
          <h3>📋 Sin nichos aún</h3>
          <p>Ejecuta <code>python main.py</code> para generar tu primera página</p>
        </div>
      )}
    </div>
    
    <footer>
      <p><strong>© 2024 Web Maker</strong></p>
      <p>Generador de páginas de nicho con IA</p>
    </footer>
  </div>
</body>
</html>
