---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import type { NicheContent } from '../content/config';

// Cargar todos los JSONs en src/content/
const files = import.meta.glob<{ default: NicheContent }>('../content/**/*.json', {
  eager: true,
  import: 'default',
});

const nichesArray = Object.entries(files)
  .map(([path, module]) => {
    const filename = path.split('/').pop() || '';
    const slug = filename.replace('.json', '');
    return {
      slug,
      title: module.title,
      description: module.description,
      count: module.products ? module.products.length : 0,
    };
  })
  .sort(() => Math.random() - 0.5); // Opcional: aleatorio

const totalNiches = nichesArray.length;
const totalProducts = nichesArray.reduce((sum, n) => sum + n.count, 0);

const title = 'Comparativas de Productos - Web Maker';
const description = 'Guías de compra y comparativas de productos de calidad. Análisis independientes para ayudarte a elegir lo mejor.';
---

<BaseLayout title={title} description={description}>
  <Header title="Web Maker" />

  <main>
    {/* Hero Section */}
    <Hero
      title="Encuentra los Mejores Productos"
      subtitle="Comparativas independientes y análisis detallados para tomar las mejores decisiones de compra"
      cta={{
        text: 'Explorar Categorías',
        href: '#niches',
      }}
    />

    {/* Stats Section */}
    <section class="py-16 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { value: totalNiches, label: 'Categorías Analizadas' },
            { value: totalProducts, label: 'Productos Comparados' },
            { value: '100%', label: 'Análisis Independiente' }
          ].map((stat) => (
            <div class="p-8 bg-gray-50 rounded-[var(--radius)] border border-gray-100 hover:shadow-md transition-shadow text-center group">
              <div class="text-5xl font-bold text-[var(--primary)] mb-3 group-hover:scale-110 transition-transform">{stat.value}</div>
              <p class="text-gray-600 text-lg font-medium">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Por qué confiar en nosotros */}
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-6 max-w-6xl">
        <h2 class="text-3xl md:text-4xl font-bold text-center mb-12 text-gray-900">¿Por qué Confiar en Nosotros?</h2>
        <div class="grid md:grid-cols-3 gap-8">
          {[
            { icon: '🔍', title: 'Análisis Detallado', desc: 'Investigamos cada producto a fondo para ofrecerte información completa y honesta.' },
            { icon: '⭐', title: 'Opiniones Reales', desc: 'Basamos nuestras recomendaciones en miles de reseñas y datos verificados.' },
            { icon: '✓', title: 'Sin Sesgos', desc: 'Nuestras evaluaciones son independientes y nunca están influenciadas por intereses comerciales.' }
          ].map((item) => (
            <div class="p-8 bg-white rounded-[var(--radius)] border border-gray-100 shadow-sm hover:shadow-md hover:border-[var(--primary)] transition-all duration-300 text-center">
              <div class="text-5xl mb-4">{item.icon}</div>
              <h3 class="text-xl font-bold text-gray-900 mb-3">{item.title}</h3>
              <p class="text-gray-600 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Niches Grid */}
    <section id="niches" class="py-20 bg-white">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-center mb-4 text-gray-900">Explora Nuestras Comparativas</h2>
          <p class="text-center text-gray-600 text-lg max-w-2xl mx-auto">
            Selecciona una categoría para ver análisis detallados, comparativas y recomendaciones de los mejores productos.
          </p>
        </div>

        {nichesArray.length > 0 ? (
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {nichesArray.map((niche) => (
              <a
                href={`/${niche.slug}/`}
                class="group relative overflow-hidden bg-white rounded-[var(--radius)] border border-gray-100 shadow-sm hover:shadow-md hover:border-[var(--primary)] transition-all duration-300 p-8"
              >
                {/* Gradient overlay on hover */}
                <div class="absolute inset-0 bg-gradient-to-br from-indigo-50/0 to-indigo-50/50 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
                
                <div class="relative z-10 flex flex-col h-full">
                  <div class="flex justify-between items-start mb-4">
                    <h3 class="text-xl font-bold text-gray-900 pr-6 group-hover:text-[var(--primary)] transition-colors">{niche.title}</h3>
                    <span class="text-2xl text-gray-400 group-hover:text-[var(--primary)] group-hover:scale-125 transition-all flex-shrink-0">→</span>
                  </div>
                  
                  <p class="text-gray-600 mb-6 flex-grow text-sm leading-relaxed">{niche.description}</p>
                  
                  <div class="inline-flex items-center gap-2">
                    <span class="inline-flex items-center gap-2 bg-indigo-50 text-indigo-700 px-3 py-1 rounded-full text-sm font-medium">
                      📦 {niche.count} {niche.count === 1 ? 'producto' : 'productos'}
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-20 bg-gray-50 rounded-[var(--radius)] border border-gray-100">
            <p class="text-2xl font-bold text-gray-900 mb-4">📋 Sin comparativas aún</p>
            <p class="text-gray-600">Ejecuta <code class="bg-gray-200 px-2 py-1 rounded text-sm">python main.py</code> para generar tu primera página</p>
          </div>
        )}
      </div>
    </section>

    {/* CTA Final */}
    <section class="py-20 bg-gradient-to-r from-[var(--primary)] to-indigo-600 text-white relative overflow-hidden">
      {/* Decoración de fondo */}
      <div class="absolute top-0 right-0 -mr-32 -mt-32 w-96 h-96 bg-white/10 rounded-full blur-3xl"></div>
      
      <div class="container mx-auto px-6 max-w-4xl text-center relative z-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-6">¿Necesitas Ayuda para Elegir?</h2>
        <p class="text-lg md:text-xl mb-10 text-white/90 leading-relaxed">
          Nuestras guías de compra están diseñadas para simplificar tu decisión. Explora nuestras comparativas hoy.
        </p>
        <a
          href="#niches"
          class="inline-block bg-white text-[var(--primary)] px-8 py-4 rounded-[var(--radius)] font-bold hover:shadow-xl hover:scale-105 transition-all duration-300"
        >
          Ver Todas las Comparativas
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
