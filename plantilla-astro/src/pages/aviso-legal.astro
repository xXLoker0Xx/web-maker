---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Aviso Legal - Web Maker';
const description = 'Aviso legal y términos de uso de Web Maker. Información sobre nuestro modelo de negocio y responsabilidades.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <Header />

  <main class="flex-grow bg-gray-50">
    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="max-w-5xl mx-auto w-full px-6 py-4 text-sm text-gray-500">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-[var(--primary)] transition-colors">Inicio</a></li>
        <li>/</li>
        <li class="text-gray-900 font-medium" aria-current="page">Aviso Legal</li>
      </ol>
    </nav>

    {/* Hero Section */}
    <div class="hero-gradient text-white rounded-[var(--radius)] shadow-lg max-w-5xl mx-auto w-full px-6 mb-12 p-12 text-center">
      <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4">Aviso Legal</h1>
      <p class="text-lg opacity-90">Información sobre nuestro sitio, términos de uso y responsabilidades</p>
    </div>

    <div class="max-w-5xl mx-auto px-6 pb-20">
      
      {/* Última actualización */}
      <p class="text-gray-600 text-sm mb-12">
        Última actualización: {new Date().toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>

      {/* Aviso importante */}
      <div class="bg-amber-50 border-l-4 border-[var(--accent)] p-6 rounded-[var(--radius)] mb-12 shadow-sm">
        <h2 class="font-bold text-amber-900 mb-2 flex items-center gap-2">
          <span>⚠️</span> Aviso Importante
        </h2>
        <p class="text-amber-900 text-sm">
          Este sitio es un participante en el Programa de Asociados de Amazon Services LLC, un programa de publicidad de afiliados diseñado para proporcionar un medio para que los sitios obtengan honorarios publicitarios por publicidad y enlaces a Amazon.
        </p>
      </div>

      {/* Contenido */}
      <div class="space-y-12">
        {[
          {
            num: '1',
            title: 'Propósito del Sitio',
            content: 'Web Maker es un sitio web de análisis, comparativas y recomendaciones de productos. Nuestro objetivo es ayudarte a tomar decisiones de compra informadas proporcionando información detallada sobre diversos productos disponibles.'
          },
          {
            num: '2',
            title: 'Naturaleza del Contenido',
            content: 'Todo el contenido en nuestro sitio, incluyendo análisis de productos, comparativas, pros, contras y recomendaciones, es proporcionado con fines informativos únicamente. Los contenidos pueden generarse utilizando información técnica, análisis automático y recopilación de datos.'
          },
          {
            num: '3',
            title: 'Disclaimer de Responsabilidad',
            content: 'Web Maker NO garantiza la exactitud, completitud, actualización o confiabilidad del contenido del sitio. El contenido se proporciona "tal cual" sin garantías de ningún tipo.',
            hasList: true,
            listItems: [
              'Errores u omisiones en la información de productos',
              'Cambios en precios, disponibilidad o características de productos',
              'Daños o perjuicios resultantes del uso de este sitio',
              'La calidad o desempeño de los productos comprados',
              'Decisiones de compra basadas en nuestras recomendaciones'
            ]
          },
          {
            num: '4',
            title: 'Enlaces de Afiliados',
            content: 'Cuando haces clic en un enlace de producto y compras, nosotros recibimos una comisión. Esto NO afecta el precio que pagas. Nuestras recomendaciones se basan en análisis objetivo.'
          },
          {
            num: '5',
            title: 'Independencia Editorial',
            content: 'Nuestro sitio es independiente. Aunque participamos en programas de afiliados, esto no afecta nuestros criterios de selección y análisis de productos.'
          },
          {
            num: '6',
            title: 'Limitación de Responsabilidad',
            content: 'En la máxima medida permitida por la ley, Web Maker no será responsable de daños resultantes del uso o la imposibilidad de usar el sitio.'
          },
          {
            num: '7',
            title: 'Propiedad Intelectual',
            content: 'El contenido original de este sitio está protegido por derechos de autor. Se permite la visualización personal, pero no la reproducción comercial sin permiso.'
          }
        ].map((section) => (
          <section class="bg-white rounded-[var(--radius)] border border-gray-100 p-8 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-start gap-4 mb-4">
              <span class="inline-flex items-center justify-center w-10 h-10 bg-[var(--primary)] text-white font-bold rounded-full flex-shrink-0 text-sm">
                {section.num}
              </span>
              <h2 class="text-2xl font-bold text-gray-900">{section.title}</h2>
            </div>
            <p class="text-gray-700 leading-relaxed ml-14 mb-4">{section.content}</p>
            {section.hasList && (
              <ul class="ml-14 space-y-3">
                {section.listItems?.map((item) => (
                  <li class="flex items-start gap-3 text-gray-700">
                    <span class="text-red-500 font-bold mt-0.5">✗</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
</body>
</html>
