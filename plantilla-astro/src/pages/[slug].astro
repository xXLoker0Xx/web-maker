---
import ProductCard from '../components/ProductCard.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import type { NicheContent } from '../content/config';
import fs from 'fs';
import path from 'path';

interface Props {
  content: NicheContent;
  slug: string;
}

export async function getStaticPaths() {
  try {
    const nichesDir = path.join(process.cwd(), 'src', 'content', 'niches');
    
    if (!fs.existsSync(nichesDir)) {
      console.warn('Directorio niches no encontrado:', nichesDir);
      return [];
    }
    
    const files = fs.readdirSync(nichesDir).filter(f => f.endsWith('.json'));
    
    if (!files || files.length === 0) {
      console.warn('No se encontraron archivos JSON en:', nichesDir);
      return [];
    }

    const paths = files.map((file) => {
      const slug = file.replace('.json', '');
      const filePath = path.join(nichesDir, file);
      const content = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
      
      return {
        params: { slug },
        props: { content, slug }
      };
    });
    
    return paths;
  } catch (error) {
    console.error('Error en getStaticPaths:', error);
    return [];
  }
}

const { content, slug } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Extraer el mejor producto para la sección "Top Pick" (asumiendo que es el primero)
const bestProduct = content.products && content.products.length > 0 ? content.products[0] : null;

// Iconos dinámicos para los criterios de compra (GEO visual)
const criteriaIcons = ['⚡', '🛡️', '💰', '🔋', '⭐', '🔧', '📊'];

// Generación de Schema Markup (JSON-LD) para GEO
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL.toString()
  },
  "headline": content.title,
  "description": content.description,
  "author": {
    "@type": "Organization",
    "name": "Equipo Editorial",
    "url": Astro.site
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": Astro.site
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Comparativas",
      "item": new URL("/comparativas", Astro.site).toString()
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": content.title,
      "item": canonicalURL.toString()
    }
  ]
};
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#4F46E5" />
    
    <!-- SEO & Metadatos -->
    <title>{content.title} | Opiniones y Guía 2026</title>
    <meta name="description" content={content.description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={content.title} />
    <meta property="og:description" content={content.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Schema Markup (GEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    
    <style is:global>
      /* Design Tokens exigidos por las instrucciones */
      :root {
        --primary: #6366F1;
        --primary-dark: #4F46E5;
        --accent: #F59E0B;
        --background: #F8FAFC;
        --surface: #FFFFFF;
        --text: #111827;
        --text-muted: #6B7280;
        --border: #E5E7EB;
        --success: #10B981;
        --radius: 16px;
      }
      body {
        background-color: var(--background);
        color: var(--text);
      }
      .hero-gradient {
        background: linear-gradient(135deg, #5B7CFF, #7F5AF0);
      }
    </style>
  </head>
  
  <body class="font-sans antialiased text-gray-900 bg-[#F8FAFC] flex flex-col min-h-screen">
    
    <!-- Banner de Transparencia Compacto (Cumplimiento Amazon) -->
    <div class="bg-gray-100 border-b border-gray-200 text-xs text-gray-500 py-2 px-4 text-center">
      <span class="inline-flex items-center gap-1 max-w-4xl mx-auto">
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path></svg>
        <strong>Transparencia:</strong> Como afiliado de Amazon, obtengo ingresos por las compras adscritas que cumplen los requisitos aplicables.
      </span>
    </div>

    <!-- Navegación Breadcrumb -->
    <nav aria-label="Breadcrumb" class="max-w-5xl mx-auto w-full px-4 py-4 text-sm text-gray-500">
      <ol class="flex items-center gap-2">
        <li><a href="/" class="hover:text-[var(--primary)] transition-colors">Inicio</a></li>
        <li>/</li>
        <li><a href="/comparativas" class="hover:text-[var(--primary)] transition-colors">Comparativas</a></li>
        <li>/</li>
        <li class="text-gray-900 font-medium truncate" aria-current="page">{content.title}</li>
      </ol>
    </nav>

    <main class="flex-grow">
      <article class="max-w-5xl mx-auto w-full px-4 pb-20">
        
        <!-- Hero Section -->
        <header class="hero-gradient text-white rounded-[var(--radius)] p-8 md:p-12 mb-10 text-center shadow-lg">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6">
            {content.title}
          </h1>
          <p class="text-lg md:text-xl opacity-90 max-w-3xl mx-auto leading-relaxed">
            {content.description}
          </p>
        </header>

        <!-- TOC y Contenido Layout -->
        <div class="flex flex-col lg:flex-row gap-10">
          
          <!-- Contenido Principal -->
          <div class="lg:w-3/4 space-y-12">
            
            <!-- Resumen Ejecutivo / Intro -->
            <section id="introduccion" class="prose prose-lg prose-indigo max-w-none text-gray-700">
              <p class="text-lg leading-relaxed">{content.intro}</p>
            </section>

            <!-- Sección: Top Pick (El Producto Recomendado) -->
            {bestProduct && (
              <section id="mejor-eleccion" class="bg-white rounded-[var(--radius)] border border-[var(--primary)] p-1 shadow-md">
                <div class="bg-indigo-50 rounded-[calc(var(--radius)-4px)] p-6 md:p-8 relative">
                  <div class="absolute -top-4 left-6 bg-[var(--primary)] text-white text-sm font-bold uppercase tracking-wide py-1 px-4 rounded-full shadow-sm flex items-center gap-2">
                    🏆 Nuestra Elección
                  </div>
                  <h2 class="text-2xl font-bold text-gray-900 mt-2 mb-4">El mejor modelo en general</h2>
                  <p class="text-gray-700 mb-6">Después de analizar las métricas técnicas y las opiniones verificadas, esta es la recomendación definitiva de nuestro equipo editorial por su balance entre calidad, rendimiento y precio.</p>
                  
                  <!-- Aquí deberías inyectar el componente visual de tu Top Pick real -->
                  <!-- <TopPick product={bestProduct} /> -->
                </div>
              </section>
            )}

            <!-- Tabla Comparativa HTML Pura (Optimización GEO) -->
            <section id="comparativa" class="scroll-mt-8">
              <h2 class="text-3xl font-bold text-gray-900 mb-6">Comparativa Rápida</h2>
              {content.products && content.products.length > 0 && (
                <div class="bg-white rounded-[var(--radius)] p-6 shadow-sm border border-gray-100 overflow-x-auto">
                  <ComparisonTable products={content.products} />
                </div>
              )}
            </section>

            <!-- Criterios de Compra (Iconografía) -->
            {content.buying_criteria && content.buying_criteria.length > 0 && (
              <section id="criterios" class="bg-white rounded-[var(--radius)] p-8 shadow-sm border border-gray-100 scroll-mt-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-2">Criterios de Evaluación</h2>
                <p class="text-gray-500 mb-8">Cómo clasificamos y puntuamos estos productos:</p>
                
                <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                  {content.buying_criteria.map((criterion: string, index: number) => (
                    <div class="flex flex-col items-center text-center p-4 rounded-xl bg-gray-50 border border-gray-100 hover:border-indigo-300 hover:shadow-md transition-all duration-300 group">
                      <div class="w-12 h-12 bg-indigo-100 rounded-full flex items-center justify-center text-2xl mb-3 group-hover:scale-110 transition-transform">
                        {criteriaIcons[index % criteriaIcons.length]}
                      </div>
                      <h3 class="text-sm font-semibold text-gray-800">{criterion}</h3>
                    </div>
                  ))}
                </div>
              </section>
            )}

            <!-- Veredicto Final -->
            <section id="veredicto" class="bg-gray-900 text-white rounded-[var(--radius)] p-8 md:p-10 shadow-xl scroll-mt-8 relative overflow-hidden">
              <!-- Decoración de fondo -->
              <div class="absolute top-0 right-0 -mr-16 -mt-16 w-64 h-64 bg-indigo-600 rounded-full blur-3xl opacity-20"></div>
              
              <h2 class="text-3xl font-bold mb-4 relative z-10">Veredicto Final</h2>
              <p class="text-lg text-gray-300 leading-relaxed relative z-10">
                {content.verdict}
              </p>
            </section>
          </div>

          <!-- Barra Lateral (Desktop Nav / Sticky TOC) -->
          <aside class="hidden lg:block lg:w-1/4">
            <div class="sticky top-8 bg-white p-6 rounded-[var(--radius)] shadow-sm border border-gray-100">
              <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-4">En este artículo</h3>
              <ul class="space-y-3 text-sm text-gray-600">
                <li><a href="#introduccion" class="hover:text-[var(--primary)] transition-colors">Resumen</a></li>
                {bestProduct && (
                  <li><a href="#mejor-eleccion" class="hover:text-[var(--primary)] transition-colors">Nuestra Elección</a></li>
                )}
                <li><a href="#comparativa" class="hover:text-[var(--primary)] transition-colors">Tabla Comparativa</a></li>
                <li><a href="#criterios" class="hover:text-[var(--primary)] transition-colors">Criterios de Evaluación</a></li>
                <li><a href="#veredicto" class="hover:text-[var(--primary)] transition-colors">Veredicto Final</a></li>
              </ul>
            </div>
          </aside>

        </div>
      </article>
    </main>
    
    <!-- Footer Editorial Profesional -->
    <footer class="bg-white border-t border-gray-200 mt-auto">
      <div class="max-w-5xl mx-auto px-4 py-12">
        <div class="flex flex-col md:flex-row justify-between items-center gap-6">
          <div class="text-center md:text-left">
            <p class="font-bold text-gray-900 text-xl tracking-tight">Editorial<span class="text-[var(--primary)]">Reviews</span></p>
            <p class="text-sm text-gray-500 mt-2">Guías de compra objetivas y basadas en datos.</p>
          </div>
          <nav aria-label="Footer Navigation">
            <ul class="flex flex-wrap justify-center gap-6 text-sm font-medium text-gray-600">
              <li><a href="/aviso-legal" class="hover:text-gray-900 transition-colors">Aviso Legal</a></li>
              <li><a href="/politica-de-privacidad" class="hover:text-gray-900 transition-colors">Privacidad</a></li>
              <li><a href="/disclaimer-afiliados" class="hover:text-gray-900 transition-colors">Transparencia</a></li>
            </ul>
          </nav>
        </div>
        <div class="mt-8 pt-8 border-t border-gray-100 text-center text-sm text-gray-500">
          <p>© 2026 EditorialReviews. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>
    
  </body>
</html>