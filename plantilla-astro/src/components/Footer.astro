---
// Footer.astro - Pie de página híbrido: minimalista profesional con links legales
interface Props {
  showLegalLinks?: boolean;
}

const { showLegalLinks = true } = Astro.props;
---

<!-- Footer Profesional Minimalista (Inspirado en [slug].astro) -->
<footer class="bg-white border-t border-gray-200 mt-auto">
  <div class="max-w-6xl mx-auto px-6 py-12">
    
    <!-- Sección principal: Brand + Navigation -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-8 mb-8">
      
      {/* Brand */}
      <div class="text-center md:text-left">
        <p class="font-bold text-gray-900 text-xl tracking-tight">Web<span class="text-[var(--primary)]">Maker</span></p>
        <p class="text-sm text-gray-500 mt-2">Comparativas independientes y análisis detallados.</p>
      </div>

      {/* Navigation Links */}
      {showLegalLinks && (
        <nav aria-label="Footer Navigation">
          <ul class="flex flex-wrap justify-center md:justify-end gap-6 text-sm font-medium text-gray-600">
            <li><a href="/aviso-legal" class="hover:text-[var(--primary)] transition-colors">Aviso Legal</a></li>
            <li><a href="/politica-de-privacidad" class="hover:text-[var(--primary)] transition-colors">Privacidad</a></li>
            <li><a href="/politica-de-cookies" class="hover:text-[var(--primary)] transition-colors">Cookies</a></li>
            <li><a href="/disclaimer-afiliados" class="hover:text-[var(--primary)] transition-colors">Transparencia</a></li>
          </ul>
        </nav>
      )}
    </div>

    {/* Divider */}
    <div class="border-t border-gray-100 pt-8">
      
      {/* Copyright + Amazon Disclaimer */}
      <div class="text-center space-y-3">
        <p class="text-sm text-gray-600">
          © 2026 Web Maker. Todos los derechos reservados.
        </p>
        <p class="text-xs text-gray-500 flex items-center justify-center gap-2">
          <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
          </svg>
          <strong>Transparencia:</strong> Como afiliado de Amazon, obtengo ingresos por las compras adscritas que cumplen los requisitos aplicables.
        </p>
      </div>
    </div>

  </div>
</footer>
