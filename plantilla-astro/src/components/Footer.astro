---
// Footer.astro - Pie de página profesional
interface Props {
  showLegalLinks?: boolean;
}

const { showLegalLinks = true } = Astro.props;
---

<footer class="bg-gray-900 text-white py-16">
  <div class="container mx-auto px-6 max-w-7xl">
    <div class="grid md:grid-cols-4 gap-12 mb-12">
      {/* About */}
      <div>
        <h3 class="font-bold text-lg mb-4">Sobre Nosotros</h3>
        <p class="text-gray-400 text-sm leading-relaxed">
          Proporcionamos análisis independientes y comparativas honestas de productos para ayudarte a tomar las
          mejores decisiones de compra.
        </p>
      </div>

      {/* Legal Links */}
      {showLegalLinks && (
        <div>
          <h3 class="font-bold text-lg mb-4">Legal</h3>
          <ul class="space-y-2 text-sm">
            <li>
              <a href="/aviso-legal" class="text-gray-400 hover:text-white transition-colors">Aviso Legal</a>
            </li>
            <li>
              <a href="/politica-de-privacidad" class="text-gray-400 hover:text-white transition-colors">
                Política de Privacidad
              </a>
            </li>
            <li>
              <a href="/politica-de-cookies" class="text-gray-400 hover:text-white transition-colors">
                Política de Cookies
              </a>
            </li>
            <li>
              <a href="/disclaimer-afiliados" class="text-gray-400 hover:text-white transition-colors">
                Disclaimer de Afiliados
              </a>
            </li>
          </ul>
        </div>
      )}

      {/* Contact */}
      <div>
        <h3 class="font-bold text-lg mb-4">Contacto</h3>
        <p class="text-gray-400 text-sm">
          📧 <a href="mailto:contacto@example.com" class="hover:text-white transition-colors">contacto@example.com</a>
        </p>
      </div>

      {/* Social */}
      <div>
        <h3 class="font-bold text-lg mb-4">Síguenos</h3>
        <div class="flex gap-4">
          <a href="#" class="text-gray-400 hover:text-white transition-colors">
            <span class="sr-only">Twitter</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M6.29 18.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0020 3.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 01.8 7.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 010 16.407a11.616 11.616 0 006.29 1.84"
              />
            </svg>
          </a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors">
            <span class="sr-only">Facebook</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                d="M10 0C4.477 0 0 4.484 0 10.017c0 4.925 3.474 9.26 8.034 9.868v-6.987h-2.412V9.99h2.412V7.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562v1.876h2.773l-.443 2.89h-2.33v6.988C16.525 19.268 20 14.93 20 10.017c0-5.533-4.477-10.017-10-10.017z"
              />
            </svg>
          </a>
        </div>
      </div>
    </div>

    {/* Copyright */}
    <div class="border-t border-gray-800 pt-8">
      <div class="text-center text-gray-400 text-sm">
        <p>
          &copy; 2026 Web Maker. Todos los derechos reservados.
          <br />
          <span class="text-xs mt-2 block">
            Como afiliado de Amazon, obtengo ingresos por las compras adscritas que cumplen los requisitos aplicables.
          </span>
        </p>
      </div>
    </div>
  </div>
</footer>
