---
// ScoreDisplay.astro - Componente para mostrar scores de productos
// Renderiza barras de puntuación para Overall, Valor y Rendimiento

interface Props {
  score?: number;
  value_score?: number;
  performance_score?: number;
}

const { 
  score = 0, 
  value_score = 0, 
  performance_score = 0 
} = Astro.props;

// Función para determinar el color basado en score
const getScoreColor = (value: number) => {
  if (value >= 8.5) return '#10B981'; // success (green)
  if (value >= 7) return '#F59E0B'; // warning (amber)
  return '#EF4444'; // error (red)
};

// Función para determinar la clase de background
const getScoreBgClass = (value: number) => {
  if (value >= 8.5) return 'bg-emerald-50';
  if (value >= 7) return 'bg-amber-50';
  return 'bg-red-50';
};

// Función para determinar la clase de barra
const getScoreBarClass = (value: number) => {
  if (value >= 8.5) return 'bg-emerald-500';
  if (value >= 7) return 'bg-amber-500';
  return 'bg-red-500';
};
---

{(score > 0 || value_score > 0 || performance_score > 0) && (
  <div class="scores-container">
    <h4 class="scores-title">📊 Puntuación</h4>
    
    <div class="scores-grid">
      {score > 0 && (
        <div class={`score-item ${getScoreBgClass(score)}`}>
          <div class="score-header">
            <span class="score-label">Puntuación General</span>
            <span class="score-value">{score.toFixed(1)}/10</span>
          </div>
          <div class="score-bar-bg">
            <div 
              class={`score-bar-fill ${getScoreBarClass(score)}`}
              style={{width: `${(score / 10) * 100}%`}}
            ></div>
          </div>
        </div>
      )}

      {value_score > 0 && (
        <div class={`score-item ${getScoreBgClass(value_score)}`}>
          <div class="score-header">
            <span class="score-label">Relación Precio-Valor</span>
            <span class="score-value">{value_score.toFixed(1)}/10</span>
          </div>
          <div class="score-bar-bg">
            <div 
              class={`score-bar-fill ${getScoreBarClass(value_score)}`}
              style={{width: `${(value_score / 10) * 100}%`}}
            ></div>
          </div>
        </div>
      )}

      {performance_score > 0 && (
        <div class={`score-item ${getScoreBgClass(performance_score)}`}>
          <div class="score-header">
            <span class="score-label">Rendimiento</span>
            <span class="score-value">{performance_score.toFixed(1)}/10</span>
          </div>
          <div class="score-bar-bg">
            <div 
              class={`score-bar-fill ${getScoreBarClass(performance_score)}`}
              style={{width: `${(performance_score / 10) * 100}%`}}
            ></div>
          </div>
        </div>
      )}
    </div>
  </div>
)}

<style>
  .scores-container {
    margin-bottom: 1.25rem;
    padding: 1rem;
    background: #f9fafb;
    border-radius: 12px;
    border-left: 4px solid #6366f1;
  }

  .scores-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
    margin: 0 0 0.75rem 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .scores-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .score-item {
    padding: 0.75rem;
    border-radius: 8px;
    background: white;
    border: 1px solid #e5e7eb;
  }

  .score-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .score-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: #6b7280;
  }

  .score-value {
    font-size: 0.875rem;
    font-weight: 700;
    color: #111827;
  }

  .score-bar-bg {
    width: 100%;
    height: 6px;
    background: #e5e7eb;
    border-radius: 3px;
    overflow: hidden;
  }

  .score-bar-fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.3s ease;
  }

  @media (max-width: 768px) {
    .scores-container {
      padding: 0.75rem;
      margin-bottom: 1rem;
    }

    .score-label {
      font-size: 0.8rem;
    }

    .score-value {
      font-size: 0.8rem;
    }
  }
</style>
