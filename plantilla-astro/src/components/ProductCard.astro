---
// ProductCard.astro - Componente para mostrar detalles individuales de productos
// Recibe información del producto y renderiza una tarjeta con diseño profesional

interface Props {
  asin: string;
  title: string;
  image_url?: string;
  price?: string;
  rating?: number;
  reviews_count?: number;
  badge: string;
  pros: string[];
  cons: string[];
  summary: string;
  affiliate_url?: string;
}

const {
  asin,
  title,
  image_url,
  price,
  rating = 0,
  reviews_count = 0,
  badge,
  pros,
  cons,
  summary,
  affiliate_url,
} = Astro.props;

// Función para generar estrellas
const renderStars = (rating: number) => {
  const fullStars = Math.floor(rating);
  const hasHalf = rating % 1 >= 0.5;
  let stars = '★'.repeat(fullStars);
  if (hasHalf && fullStars < 5) stars += '½';
  const emptyStars = 5 - Math.ceil(rating);
  stars += '☆'.repeat(emptyStars);
  return stars;
};
---

<article class="product-card">
  <!-- Badge Premium -->
  <div class="badge-container">
    <span class="badge">{badge}</span>
  </div>

  <!-- Imagen del Producto -->
  {
    image_url && (
      <div class="product-image">
        <img 
          src={image_url} 
          alt={title}
          loading="lazy"
          decoding="async"
          width="300"
          height="300"
        />
      </div>
    )
  }

  <!-- Información del Producto -->
  <div class="product-info">
    <h3 class="product-title">{title}</h3>

    <!-- Rating y Reviews -->
    {
      rating > 0 && (
        <div class="rating-section">
          <div class="stars">{renderStars(rating)}</div>
          <span class="rating-number">{rating.toFixed(1)}/5</span>
          {reviews_count > 0 && (
            <span class="reviews-count">({reviews_count.toLocaleString('es-ES')} reseñas)</span>
          )}
        </div>
      )
    }

    <!-- Precio -->
    {
      price && (
        <div class="price-section">
          <span class="price">{price}</span>
        </div>
      )
    }

    <!-- Resumen -->
    <p class="summary">{summary}</p>

    <!-- Pros y Contras -->
    <div class="features-grid">
      <!-- Pros -->
      <div class="features-column">
        <h4 class="features-title">✓ Ventajas</h4>
        <ul class="features-list">
          {pros.map((pro) => (
            <li class="pro">{pro}</li>
          ))}
        </ul>
      </div>

      <!-- Contras -->
      <div class="features-column">
        <h4 class="features-title">✗ Desventajas</h4>
        <ul class="features-list">
          {cons.map((con) => (
            <li class="con">{con}</li>
          ))}
        </ul>
      </div>
    </div>

    <!-- CTA Button -->
    <a
      href={affiliate_url || `https://amazon.es/dp/${asin}`}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="btn-cta"
    >
      Ver Precio en Amazon →
    </a>
  </div>
</article>

<style>
  .product-card {
    background: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
  }

  .product-card:hover {
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border-color: #3b82f6;
    transform: translateY(-2px);
  }

  .badge-container {
    padding: 0.75rem 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    text-align: center;
  }

  .badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-image {
    width: 100%;
    height: 250px;
    background: #f9fafb;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .product-image img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    padding: 20px;
  }

  .product-info {
    padding: 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .product-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #111827;
    margin: 0 0 0.75rem 0;
    line-height: 1.4;
  }

  .rating-section {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
  }

  .stars {
    color: #fbbf24;
    font-size: 1rem;
    letter-spacing: 2px;
  }

  .rating-number {
    color: #6b7280;
    font-weight: 500;
  }

  .reviews-count {
    color: #9ca3af;
    font-size: 0.85rem;
  }

  .price-section {
    margin-bottom: 1rem;
  }

  .price {
    font-size: 1.5rem;
    font-weight: 700;
    color: #059669;
  }

  .summary {
    color: #4b5563;
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .features-column {
    display: flex;
    flex-direction: column;
  }

  .features-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .features-list li {
    font-size: 0.9rem;
    color: #6b7280;
    padding-left: 0;
    line-height: 1.4;
  }

  .pro {
    color: #059669;
  }

  .con {
    color: #dc2626;
  }

  .btn-cta {
    align-self: flex-start;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
  }

  .btn-cta:hover {
    transform: translateX(4px);
    box-shadow: 0 8px 16px rgba(102, 126, 234, 0.3);
  }

  .btn-cta:active {
    transform: translateX(2px);
  }

  @media (max-width: 768px) {
    .product-info {
      padding: 1.25rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .product-title {
      font-size: 1rem;
    }

    .price {
      font-size: 1.25rem;
    }
  }
</style>
