---
// ComparisonTable.astro - Tabla comparativa compacta y directa
// Muestra todos los 5 productos lado a lado en una sola vista

interface Product {
  asin: string;
  title: string;
  short_title?: string;
  image_url?: string;
  price?: string;
  rating?: number;
  reviews_count?: number;
  badge: string;
  pros: string[];
  cons: string[];
  affiliate_url?: string;
}

interface Props {
  products: Product[];
}

const { products } = Astro.props;

const renderStars = (rating: number) => {
  if (!rating || rating === 0) return '—';
  const fullStars = Math.floor(rating);
  const hasHalf = rating % 1 >= 0.5;
  let stars = '★'.repeat(fullStars);
  if (hasHalf && fullStars < 5) stars += '½';
  const emptyStars = 5 - Math.ceil(rating);
  stars += '☆'.repeat(emptyStars);
  return stars;
};
---

<div class="comparison-wrapper">
  <!-- Desktop: Tabla horizontal compacta -->
  <div class="comparison-table-container">
    <table class="quick-comparison">
      <thead>
        <tr>
          {products.map((product) => (
            <th class="product-column">
              {product.image_url && (
                <img
                  src={product.image_url}
                  alt={product.title}
                  class="column-image"
                  loading="lazy"
                />
              )}
              <div class="column-title">{product.title}</div>
              {product.short_title && (
                <div class="column-subtitle">{product.short_title}</div>
              )}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        <!-- Fila de Insignia -->
        <tr>
          {products.map((product) => (
            <td class="cell-badge">
              <span class="badge">{product.badge}</span>
            </td>
          ))}
        </tr>

        <!-- Fila de Precio -->
        <tr>
          {products.map((product) => (
            <td class="cell-price">
              <span class="price-text">{product.price || 'N/A'}</span>
            </td>
          ))}
        </tr>

        <!-- Fila de Rating -->
        <tr>
          {products.map((product) => (
            <td class="cell-rating">
              {product.rating && product.rating > 0 ? (
                <div>
                  <div class="rating-stars">{renderStars(product.rating)}</div>
                  <div class="rating-value">{product.rating.toFixed(1)}/5</div>
                </div>
              ) : (
                <span>Sin rating</span>
              )}
            </td>
          ))}
        </tr>

        <!-- Fila de Ventajas (Pros) -->
        <tr>
          {products.map((product) => (
            <td class="cell-pros">
              <div class="pros-list">
                {product.pros && product.pros.length > 0 ? (
                  product.pros.map((pro, idx) => (
                    <div key={idx} class="pro-item">
                      <span class="pro-check">✓</span>
                      <span>{pro}</span>
                    </div>
                  ))
                ) : (
                  <span class="empty">—</span>
                )}
              </div>
            </td>
          ))}
        </tr>

        <!-- Fila de Desventajas (Cons) -->
        <tr>
          {products.map((product) => (
            <td class="cell-cons">
              <div class="cons-list">
                {product.cons && product.cons.length > 0 ? (
                  product.cons.map((con, idx) => (
                    <div key={idx} class="con-item">
                      <span class="con-check">✗</span>
                      <span>{con}</span>
                    </div>
                  ))
                ) : (
                  <span class="empty">—</span>
                )}
              </div>
            </td>
          ))}
        </tr>

        <!-- Fila de Botón de Acción -->
        <tr>
          {products.map((product) => (
            <td class="cell-action">
              <a
                href={product.affiliate_url || `https://amazon.es/dp/${product.asin}`}
                target="_blank"
                rel="noopener noreferrer sponsored"
                class="action-button"
              >
                Ver en Amazon →
              </a>
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Mobile: Comparativa horizontal scrolleable -->
  <div class="mobile-comparison-scroll">
    <div class="scroll-container">
      {products.map((product) => (
        <div class="comparison-card-mobile">
          <div class="card-header-mobile">
            {product.image_url && (
              <img
                src={product.image_url}
                alt={product.title}
                class="card-image-mobile"
                loading="lazy"
              />
            )}
            <h3 class="card-title-mobile">{product.title}</h3>
            <span class="badge-mobile">{product.badge}</span>
          </div>

          <div class="card-content-mobile">
            <div class="info-row">
              <span class="label">Precio:</span>
              <span class="value">{product.price || 'N/A'}</span>
            </div>

            {product.rating && product.rating > 0 && (
              <div class="info-row">
                <span class="label">Rating:</span>
                <div class="value">
                  <div>{renderStars(product.rating)}</div>
                  <div class="rating-number">{product.rating.toFixed(1)}/5</div>
                </div>
              </div>
            )}

            {product.pros && product.pros.length > 0 && (
              <div class="info-section">
                <h4 class="section-label">✓ Ventajas</h4>
                <ul class="list-items">
                  {product.pros.map((pro) => (
                    <li>{pro}</li>
                  ))}
                </ul>
              </div>
            )}

            {product.cons && product.cons.length > 0 && (
              <div class="info-section">
                <h4 class="section-label">✗ Desventajas</h4>
                <ul class="list-items">
                  {product.cons.map((con) => (
                    <li>{con}</li>
                  ))}
                </ul>
              </div>
            )}

            <a
              href={product.affiliate_url || `https://amazon.es/dp/${product.asin}`}
              target="_blank"
              rel="noopener noreferrer sponsored"
              class="button-mobile"
            >
              Ver en Amazon →
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>

